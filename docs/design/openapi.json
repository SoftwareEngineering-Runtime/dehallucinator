{
  "openapi": "3.1.0",
  "info": {
    "title": "Dehallucinator",
    "description": "Checks an AI answer against trusted sources and returns a corrected answer.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness check used by Docker and Jenkins.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/check": {
      "post": {
        "summary": "Check",
        "description": "Check one AI answer. A plain ``def`` so FastAPI runs it in a worker thread.",
        "operationId": "check_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckedAnswer"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error. Generic message, no stack trace (NFR-3).",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Internal server error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Text",
            "description": "The AI answer"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CheckRequest",
        "description": "Body of POST /check."
      },
      "CheckedAnswer": {
        "properties": {
          "original": {
            "type": "string",
            "title": "Original"
          },
          "corrected": {
            "type": "string",
            "title": "Corrected"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "verdicts": {
            "items": {
              "$ref": "#/components/schemas/Verdict"
            },
            "type": "array",
            "title": "Verdicts"
          },
          "trust_score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Trust Score"
          }
        },
        "type": "object",
        "required": [
          "original",
          "corrected",
          "claims",
          "verdicts",
          "trust_score"
        ],
        "title": "CheckedAnswer",
        "description": "Final output of the pipeline for one AI answer."
      },
      "Claim": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "sentence_index": {
            "type": "integer",
            "title": "Sentence Index"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "sentence_index"
        ],
        "title": "Claim",
        "description": "One standalone factual statement taken from the AI answer."
      },
      "Evidence": {
        "properties": {
          "claim_id": {
            "type": "integer",
            "title": "Claim Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "wikipedia",
              "local_kb"
            ],
            "title": "Source"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "relevance": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Relevance"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "source",
          "source_url",
          "title",
          "snippet",
          "relevance"
        ],
        "title": "Evidence",
        "description": "A snippet from a trusted source that relates to one claim."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "properties": {
          "claim_id": {
            "type": "integer",
            "title": "Claim Id"
          },
          "label": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "NOT_ENOUGH_INFO"
            ],
            "title": "Label"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "best_evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Evidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "label",
          "score"
        ],
        "title": "Verdict",
        "description": "The verifier's decision for one claim."
      }
    }
  }
}
